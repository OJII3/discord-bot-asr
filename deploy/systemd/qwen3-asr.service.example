[Unit]
Description=Qwen3 ASR WebSocket server
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/path/to/discord-bot-asr
Environment=ASR_MODEL=Qwen/Qwen3-ASR-0.6B
Environment=GPU_MEMORY_UTILIZATION=0.55
ExecStart=/path/to/uv run --project /path/to/discord-bot-asr python /path/to/discord-bot-asr/asr_server.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
