[Unit]
Description=Parakeet ASR WebSocket server
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/path/to/discord-bot-asr
ExecStart=/path/to/nix develop /path/to/discord-bot-asr --command uv run --project /path/to/discord-bot-asr python -m discord_bot_asr
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
